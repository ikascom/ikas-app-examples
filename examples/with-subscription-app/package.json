    "@tailwindcss/postcss": "^4.3.3",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql-request": "^7.0.0",
    "iron-session": "^9.0.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "next": "16.4.1",
    "postcss": "^8.5.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
